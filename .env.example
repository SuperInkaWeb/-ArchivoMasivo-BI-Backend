# Copiar a .env y ajustar. Nunca commitear el .env real.
APP_NAME=datafilter-backend
DATA_DIR=./data

# Límites de recursos (defensa OWASP A04 - Insecure Design)
MAX_UPLOAD_MB=2048
MAX_DOWNLOAD_ROWS=5000000
PREVIEW_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=120

# CORS: orígenes permitidos separados por coma (nunca "*" en producción)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (peticiones por ventana)
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DOWNLOAD=20/minute
