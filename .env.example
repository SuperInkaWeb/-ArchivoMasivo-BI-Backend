# Copiar a .env y ajustar. Nunca commitear el .env real.
APP_NAME=datafilter-backend
DATA_DIR=./data

# Metadatos: si se define, usa Postgres/Neon; si se deja vacío, usa SQLite local.
# Formato Neon: postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL=

# Almacenamiento de archivos. Si las 4 variables R2 están definidas se usa Cloudflare
# R2 (subida directa + Parquet en R2); si se dejan vacías, se usa disco local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Límites de recursos (defensa OWASP A04 - Insecure Design)
MAX_UPLOAD_MB=2048
MAX_DOWNLOAD_ROWS=5000000
PREVIEW_MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=120

# Autenticación (Auth0)
# AUTH_ENABLED=false SOLO para desarrollo local sin Auth0 (usa un usuario ficticio).
AUTH_ENABLED=true
# Dominio del tenant (ej. tu-tenant.us.auth0.com) — sin https:// ni barra final.
AUTH0_DOMAIN=
# Identifier de la API creada en Auth0 (audience del access token).
AUTH0_AUDIENCE=

# CORS: orígenes permitidos separados por coma (nunca "*" en producción)
CORS_ORIGINS=http://localhost:5173

# Rate limiting (peticiones por ventana)
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DOWNLOAD=20/minute

# Ingesta en subproceso (control de memoria)
# Conversiones pesadas EN PARALELO. Cada una corre en un proceso hijo que muere al
# terminar (el SO recupera toda su RAM). Lo que excede el tope se encola, así subir
# muchos archivos nunca desborda la RAM. Pico ≈ INGEST_MAX_WORKERS × DUCKDB_MEMORY_LIMIT.
INGEST_MAX_WORKERS=1
# Tope de RAM de DuckDB por conversión (ej. 1500MB). Vacío = DuckDB decide (puede
# superar el límite del contenedor y causar OOM). Defínelo a ≈ (RAM del contenedor /
# INGEST_MAX_WORKERS) menos un margen para Python; al superarlo, DuckDB vuelca a disco.
DUCKDB_MEMORY_LIMIT=
# Carpeta de volcado temporal de DuckDB. Vacío = subcarpeta bajo DATA_DIR.
DUCKDB_TEMP_DIR=
